{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/myapp-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "VerificationCode": {
    "ExpirationTimeInMinutes": 3,
    "MaxFailedAttempts": 5,
    "WaitingTimeInMinutesAfterResendEmail": 10
  },
  "EmailConfiguration": {
    "WelcomeSubject": "your-welcome-subject",
    "From": "your-from-email@example.com",
    "VerificationSubject": "your-verification-subject"
  },
  "Jobs": {
    "CronJobDeleteUnconfirmedUsers": "your-cron-expression-for-deleting-unconfirmed-users",
    "CronJobDeleteExpiredTokens": "your-cron-expression-for-deleting-expired-tokens",
    "TimeZone": "Pacific SA Standard Time",
    "DaysToDeleteUnverifiedAccount": 7
  },
  "HangfireDashboard": {
    "StatsPollingInterval": 7000,
    "DashboardTitle": "your-hangfire-dashboard-title",
    "DashboardPath": "/your-hangfire-dashboard-path",
    "DisplayStorageConnectionString": false
  },
  "User": {
    "AdminUser": {
      "Name": "your-name",
      "Email": "your-email@example.com",
      "Rut": "your-rut",
      "PhoneNumber": "your-phone-number",
      "BirthDate": "your-birthdate",
      "Gender": "your-gender",
      "Password": "your-password"
    },
    "RandomUserPassword": "your-random-user-password",
    "Genders": [
      "Masculino",
      "Femenino",
      "Otro"
    ]
  }
}