{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/myapp-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "User": {
    "AdminUser":
    {
      "Name": "Admin",
      "Email": "admin@tiendaucn.cl",
      "Rut": "12345678-9",
      "PhoneNumber": "+569 123456789",
      "BirthDate": "1990-01-01",
      "Gender": "Otro",
      "Password": "Admin1234!"
    },
    "RandomUserPassword": "Random1234!",
    "Genders": [
      "Masculino",
      "Femenino",
      "Otro"
    ]
  }
}